{
  "name": "zhou-history-timeline",
  "private": true,
  "description": "Static history atlas; Playwright is a development-only test tool.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "test:p0": "node tests/browser-p0.mjs",
    "test:p1": "node tests/browser-p1.mjs",
    "test:p1:lighthouse": "node tests/lighthouse-p1.mjs",
    "test:publication": "node tests/browser-publication.mjs",
    "social:png": "node tools/render-social-previews.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "lighthouse": "13.5.0",
    "playwright": "1.64.1"
  }
}
